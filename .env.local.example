# Keep authoring enabled on YOUR computer. On Vercel, leave this unset or false.
# This is only a UI switch, NOT an authentication system.
NEXT_PUBLIC_AUTHORING_MODE=true

# Quick Capture AI (local development only)
QUICK_CAPTURE_ENABLED=true
# Create a separately billed API key in your OpenAI API account; never commit the real key.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
